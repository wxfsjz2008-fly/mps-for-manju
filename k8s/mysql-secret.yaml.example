# MySQL 数据库凭证 Secret
# 使用前请替换为实际的数据库连接信息
#
# 部署步骤：
# 1. 复制此文件并替换占位符为实际值
# 2. 执行: kubectl apply -f mysql-secret.yaml
# 3. 或者直接使用 kubectl create secret 命令创建
#
# 注意: 不要将包含真实密码的文件提交到版本控制系统
#
apiVersion: v1
kind: Secret
metadata:
  name: mps-mysql-credentials
  namespace: default
type: Opaque
stringData:
  # 腾讯云 MySQL 内网地址（例如：10.0.0.1）
  MYSQL_HOST: "YOUR_MYSQL_HOST"
  # MySQL 端口（默认 3306）
  MYSQL_PORT: "3306"
  # 数据库用户名
  MYSQL_USER: "YOUR_MYSQL_USER"
  # 数据库密码
  MYSQL_PASSWORD: "YOUR_MYSQL_PASSWORD"
  # 数据库名称
  MYSQL_DATABASE: "mps"
