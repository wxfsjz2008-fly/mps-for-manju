# TAPD API 配置
# 请填写你的 TAPD 开放平台应用信息

# API 用户名（应用ID）
# 获取方式: TAPD 开放平台 -> 应用管理 -> 选择应用 -> 查看应用ID
TAPD_API_USER=your_app_id

# API 密码（应用秘钥）
# 获取方式: TAPD 开放平台 -> 应用管理 -> 选择应用 -> 查看应用秘钥
TAPD_API_PASSWORD=your_app_secret

# 项目ID（workspace_id）
# 获取方式: 进入 TAPD 项目 -> 查看 URL 中的 project_id 参数
# 例如: https://www.tapd.cn/10104801/... 中的 10104801 就是项目ID
TAPD_WORKSPACE_ID=your_workspace_id

# API 基础URL（可选，默认使用公网地址）
# 公网: https://api.tapd.cn
# 内网（腾讯内部）: https://apiv2.tapd.woa.com 或 http://oss.apiv2.tapd.woa.com
TAPD_API_URL=https://api.tapd.cn
