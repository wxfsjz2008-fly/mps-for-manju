# 服务器配置
PORT=3001

# 腾讯云配置
TENCENT_SECRET_ID=your_secret_id
TENCENT_SECRET_KEY=your_secret_key

# COS 配置
COS_REGION=ap-nanjing
COS_BUCKET=your-bucket-name

# MPS 配置
MPS_REGION=ap-nanjing
MPS_ENHANCE_TEMPLATE_ID=your_template_id

# 回调配置
CALLBACK_URL=http://your-server.com/api/mps/callback

# MySQL 数据库配置
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password
MYSQL_DATABASE=mps
